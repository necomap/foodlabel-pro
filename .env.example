# ============================================================
# FoodLabel Pro - 環境変数設定
# このファイルを .env.local としてコピーして値を設定してください
# .env.local は .gitignore に含まれています（コミットしないこと）
# ============================================================

# ----- データベース -----
# PostgreSQL接続文字列
# Vercel Postgresの場合: Settings > Storage > Connect から取得
# ローカルの場合: postgresql://USER:PASSWORD@localhost:5432/foodlabel_pro
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/foodlabel_pro"

# ----- NextAuth.js -----
# ランダムな秘密鍵 (openssl rand -base64 32 で生成)
NEXTAUTH_SECRET="your-secret-key-here"
# 本番URLまたは開発URL
NEXTAUTH_URL="http://localhost:3000"

# ----- メール送信（認証メール・パスワードリセット・自動バックアップ） -----
# 実際の送信はResend（lib/email.ts）経由。Resendダッシュボード＞API Keysから取得。
# 未設定の場合は開発モード扱いとなり、実際には送信されずコンソールログのみになる。
RESEND_API_KEY="re_..."
EMAIL_FROM="FoodLabel Pro <your-email@your-domain.com>"
# 参考: 旧SMTP設定（Gmail等）。現状lib/email.tsはResend固定でこちらは未使用。
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"

# ----- Vercel Cron（定期実行API保護用） -----
# ランダムな秘密鍵（openssl rand -base64 32 等で生成）。
# app/api/cron/keepalive・app/api/cron/backup 呼び出し時のBearerトークンとして使う。
# Vercelダッシュボード側でも同じ値を環境変数として設定すること。
CRON_SECRET="your-cron-secret-here"

# ----- Stripe（課金機能）-----
# Stripeダッシュボード > Developers > API keys から取得
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# プレミアムプランの価格ID（Stripeで作成）
STRIPE_PREMIUM_PRICE_ID="price_..."
# プロプランの価格ID（Stripeダッシュボード＞商品カタログで新規に商品・価格を作成して取得）
STRIPE_PRO_PRICE_ID="price_..."
# 「初月500円」お試しクーポンID（任意。Stripeダッシュボード＞商品カタログ＞クーポンで
# 「固定金額割引・¥480 OFF・適用期間：一度のみ(duration: once)」として作成し、発行された
# cpn_... のIDを設定する。未設定の場合はお試し価格なしの通常価格のみになる）
STRIPE_TRIAL_COUPON_ID="cpn_..."

# ----- アプリ設定 -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FoodLabel Pro"

# ----- 管理者 -----
# 管理者として初期設定するメールアドレス
ADMIN_EMAIL="admin@your-domain.com"
# 自動バックアップ（app/api/cron/backup）の送付先。未設定の場合はADMIN_EMAILに送られる。
BACKUP_EMAIL="admin@your-domain.com"
