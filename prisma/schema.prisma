generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  emailVerified        Boolean            @default(false)
  emailVerifyToken     String?
  passwordHash         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  companyName          String             @db.VarChar(200)
  representative       String?            @db.VarChar(100)
  postalCode           String?            @db.VarChar(8)
  address              String?
  phone                String?            @db.VarChar(20)
  plan                 UserPlan           @default(free)
  stripeCustomerId     String?            @db.VarChar(100)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  emailVerifyExpires   DateTime?
  loginFailCount       Int                @default(0)
  loginLockedUntil     DateTime?
  adminLogs            AdminLog[]
  ingredients          Ingredient[]
  ingredientPurchaseSettings IngredientPurchaseSetting[]
  label_print_logs     label_print_logs[]
  labels               Label[]
  labelTemplates       LabelTemplate[]
  recipes              Recipe[]
  shops                Shop[]
  subscriptions        Subscription[]

  @@map("users")
}

// 2026-08 プロプラン新設: 複数ラベルデザインテンプレート機能。
// ラベル印刷画面（app/dashboard/labels/page.tsx）の「印刷設定」を名前を付けて保存し、
// 用途別（例：小ロット用シール／A4シール大量印刷用）に切り替えて呼び出せるようにする。
// レシピ・店舗・製造日・印刷枚数など「印刷ジョブごとに変わる値」は含めず、
// レイアウト・表示項目などのデザインに関わる設定だけを保存する（詳細はtypes/index.tsの
// LabelTemplateConfig、および app/api/label-templates/route.ts 参照）。
model LabelTemplate {
  id        String   @id @default(uuid())
  userId    String
  name      String   @db.VarChar(100)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("label_templates")
}

model Shop {
  id                 String   @id @default(uuid())
  userId             String
  shopName           String   @db.VarChar(200)
  companyName        String?  @db.VarChar(200)
  representative     String?  @db.VarChar(100)
  postalCode         String?  @db.VarChar(8)
  address            String?
  phone              String?  @db.VarChar(20)
  email              String?  @db.VarChar(255)
  showPhone          Boolean  @default(true)
  showRepresentative Boolean  @default(false)
  showEmail          Boolean  @default(false)
  isDefault          Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  qrUrl              String?
  logoUrl            String?
  logoHeightMm       Int      @default(8)
  qrSizeMm           Int      @default(6)
  labels             Label[]
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shops")
}

model Category {
  id        String   @id @default(uuid())
  userId    String?
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  recipes   Recipe[]

  @@map("categories")
}

model NutritionData {
  id             Int          @id
  foodGroup      String?      @db.VarChar(10)
  foodName       String
  indexName      String?      @db.VarChar(200)
  wasteRatio     Decimal?     @db.Decimal(5, 2)
  energyKcal     Decimal?     @db.Decimal(8, 1)
  energyKj       Decimal?     @db.Decimal(8, 1)
  water          Decimal?     @db.Decimal(6, 2)
  protein        Decimal?     @db.Decimal(6, 2)
  fat            Decimal?     @db.Decimal(6, 2)
  cholesterol    Decimal?     @db.Decimal(6, 2)
  carbohydrate   Decimal?     @db.Decimal(6, 2)
  dietaryFiber   Decimal?     @db.Decimal(6, 2)
  sugar          Decimal?     @db.Decimal(6, 2)
  ash            Decimal?     @db.Decimal(6, 2)
  sodium         Decimal?     @db.Decimal(8, 2)
  saltEquivalent Decimal?     @db.Decimal(6, 2)
  potassium      Decimal?     @db.Decimal(8, 2)
  calcium        Decimal?     @db.Decimal(8, 2)
  magnesium      Decimal?     @db.Decimal(8, 2)
  alcohol        Decimal?     @db.Decimal(6, 2)
  notes          String?
  dataVersion    String       @default("2020") @db.VarChar(20)
  createdAt      DateTime     @default(now())
  ingredients    Ingredient[]

  @@map("nutrition_data")
}

model IngredientCategory {
  id          String       @id @default(uuid())
  // userId が null のカテゴリは全ユーザー共通の基本カテゴリ（管理者が作成）。
  // 値が入っているものは各ユーザーが個別に追加した自分専用のカテゴリ。
  userId      String?
  name        String       @db.VarChar(100)
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  ingredients Ingredient[]

  @@map("ingredient_categories")
}

// 共有食材（コミュニティ共有・承認済み）をレシピで使うユーザーごとに、
// 仕入れ単位・価格・保管方法・仕入れ先だけを個別に持たせるためのテーブル。
// 食材マスタ本体（名前・栄養成分・アレルゲン等）は共有元の1レコードのみで、
// 仕入れに関する情報だけがユーザーごとに異なる、という構造にするためのもの。
model IngredientPurchaseSetting {
  id            String     @id @default(uuid())
  userId        String
  ingredientId  String
  purchaseUnitG Int?
  purchasePrice Decimal?   @db.Decimal(10, 2)
  unitPrice     Decimal?   @db.Decimal(10, 4)
  storage       String?    @db.VarChar(20)
  supplier      String?    @db.VarChar(100)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientId])
  @@map("ingredient_purchase_settings")
}

model Ingredient {
  id                   String              @id @default(uuid())
  userId               String?
  ingredientCategoryId String?
  name                 String              @db.VarChar(200)
  nameKana             String?             @db.VarChar(200)
  nameSearch           String?
  nutritionId          Int?
  nutritionVariant     String?             @db.VarChar(100)
  purchaseUnitG        Int?
  purchasePrice        Decimal?            @db.Decimal(10, 2)
  unitPrice            Decimal?            @db.Decimal(10, 4)
  storage              StorageType         @default(ROOM_TEMP)
  supplier             String?             @db.VarChar(100)
  productCode          String?             @db.VarChar(100)
  // この食材の標準的な原産地（例：国産、アメリカ産）。レシピにこの食材を追加したとき、
  // その食材が最も重量の多い原材料になった場合の原産国表示欄の初期値として使う（毎回手入力しなくて済むように）。
  // レシピごとに実際の原産地が違う場合は、レシピ側の欄で個別に上書きできる。
  originCountry        String?             @db.VarChar(100)
  allergens            String[]
  isPublic             Boolean             @default(false)
  isApproved           Boolean             @default(false)
  // 共有申請の却下理由（選択式コード。lib/ingredient-rejection-reasons.ts参照）。
  // 却下されていない／再承認された場合はnull。
  rejectionReason      String?             @db.VarChar(50)
  // 却下理由が「その他」の場合の自由記述、または他の理由への補足コメント
  rejectionNote        String?
  rejectedAt           DateTime?
  // ユーザーがアプリ内通知でこの却下をまだ確認していない場合はfalse。
  // 却下されたことが一度も無い食材はデフォルトtrue（通知対象外）にしておく。
  rejectionSeen        Boolean             @default(true)
  energyKcalManual     Decimal?            @db.Decimal(8, 1)
  proteinManual        Decimal?            @db.Decimal(6, 2)
  fatManual            Decimal?            @db.Decimal(6, 2)
  carbohydrateManual   Decimal?            @db.Decimal(6, 2)
  sodiumManual         Decimal?            @db.Decimal(8, 2)
  saltEquivalentManual Decimal?            @db.Decimal(6, 2)
  dietaryFiberManual   Decimal?            @db.Decimal(6, 2)
  sugarManual          Decimal?            @db.Decimal(6, 2)
  cholesterolManual    Decimal?            @db.Decimal(6, 2)
  genericName          String?             @db.VarChar(200)
  genericNameConfirmed Boolean             @default(false)
  // 水・浄水など、どのレシピで使っても原材料表示に出す必要がない食材用。ONにすると、この食材を
  // 使っている全レシピで自動的に原材料名表示から除外される（栄養成分・アレルゲン判定には影響しない）。
  alwaysHideFromLabel  Boolean             @default(false)
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  ingredientCategory   IngredientCategory? @relation(fields: [ingredientCategoryId], references: [id])
  nutritionData        NutritionData?      @relation(fields: [nutritionId], references: [id])
  user                 User?               @relation(fields: [userId], references: [id])
  recipeIngredients    RecipeIngredient[]
  purchaseSettings     IngredientPurchaseSetting[]

  // 食材マスタ一覧・検索（userId絞り込み＋isActive）の高速化用
  @@index([userId, isActive])
  @@map("ingredients")
}

model Recipe {
  id               String             @id @default(uuid())
  userId           String
  categoryId       String?
  name             String             @db.VarChar(200)
  nameKana         String?            @db.VarChar(200)
  variationName    String?            @db.VarChar(100)
  unitCount        Int                @default(1)
  wasteRatio       Decimal            @default(0) @db.Decimal(5, 2)
  moldType         String?            @db.VarChar(50)
  wasteAmountG     Decimal?           @db.Decimal(10, 2)
  packagingNotes   String[]           @default([])  // 使用資材メモ（印刷しない・将来の在庫管理用）
  salePrice        Decimal?           @db.Decimal(10, 2)
  shelfLifeDays    Int?
  shelfLifeType    ShelfLifeType      @default(BEST_BEFORE)
  contentAmount    String?            @db.VarChar(50)
  storageMethod    String?            @default("直射日光・高温多湿を避けて保存してください。")
  barcode          String?
  notes            String?
  printComment     String?
  qualityControl   String?            @db.VarChar(100)
  bakingConditions Json?
  totalCost        Decimal?           @db.Decimal(10, 2)
  unitCost         Decimal?           @db.Decimal(10, 2)
  costRate         Decimal?           @db.Decimal(5, 4)
  totalWeightG     Decimal?           @db.Decimal(10, 2)
  energyKcal       Decimal?           @db.Decimal(8, 1)
  protein          Decimal?           @db.Decimal(6, 2)
  fat              Decimal?           @db.Decimal(6, 2)
  carbohydrate     Decimal?           @db.Decimal(6, 2)
  sodium           Decimal?           @db.Decimal(8, 2)
  saltEquivalent   Decimal?           @db.Decimal(6, 2)
  dietaryFiber     Decimal?           @db.Decimal(6, 2)
  sugar            Decimal?           @db.Decimal(6, 2)
  cholesterol      Decimal?           @db.Decimal(6, 2)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  labels           Label[]
  ingredients      RecipeIngredient[]
  steps            RecipeStep[]
  category         Category?          @relation(fields: [categoryId], references: [id])
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // レシピ一覧（userId絞り込み＋isActive／hiddenOnly＋updatedAt降順）の高速化用。
  // これが無いと一覧取得のたびにrecipesテーブル全体をスキャン＆ソートすることになり、
  // レシピ件数が増えるほど一覧表示が遅くなる原因になっていた。
  @@index([userId, isActive, updatedAt])
  @@map("recipes")
}

model RecipeIngredient {
  id                     String      @id @default(uuid())
  recipeId               String
  ingredientId           String?
  ingredientNameOverride String?     @db.VarChar(200)
  amount                 Decimal     @db.Decimal(10, 3)
  unit                   String      @default("g") @db.VarChar(10)
  displayOrder           Int         @default(0)
  sortByWeight           Boolean     @default(true)
  originCountry          String?     @db.VarChar(100)
  isPrimaryIngredient    Boolean     @default(false)
  costPrice              Decimal?    @db.Decimal(10, 4)
  costTotal              Decimal?    @db.Decimal(10, 2)
  allergenOverride       String[]
  energyKcal             Decimal?    @db.Decimal(8, 1)
  protein                Decimal?    @db.Decimal(6, 2)
  fat                    Decimal?    @db.Decimal(6, 2)
  carbohydrate           Decimal?    @db.Decimal(6, 2)
  sodium                 Decimal?    @db.Decimal(8, 2)
  saltEquivalent         Decimal?    @db.Decimal(6, 2)
  dietaryFiber           Decimal?    @db.Decimal(6, 2)
  sugar                  Decimal?    @db.Decimal(6, 2)
  cholesterol            Decimal?    @db.Decimal(6, 2)
  nutritionUnconfirmed   Boolean     @default(false)
  createdAt              DateTime    @default(now())
  isAdditive             Boolean     @default(false)
  additiveReason         String?
  // このレシピでのこの原材料の使用分だけを原材料表示から除外する（例：焼成後の含有量が表示義務の
  // 閾値未満になる添加物など、食材マスタ全体ではなく「今回の使い方」に限った例外）。
  // 食材マスタ側のalwaysHideFromLabelとは別の、レシピ単位の一時的な上書き設定。
  hideFromLabel          Boolean     @default(false)
  // 工程・用途名（任意、例：湯種／本ごね／仕上げ）。計量を分けて仕込む際の表示グループ分け用。
  // ラベルの原材料表示（法定表示）には影響しない、レシピ画面・レシピ印刷での表示のみに使う。
  processLabel           String?     @db.VarChar(50)
  ingredient             Ingredient? @relation(fields: [ingredientId], references: [id])
  recipe                 Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  // レシピ一覧・印刷・ラベル生成など「1レシピ分の材料を取得する」処理すべての高速化用。
  // これが無いと材料件数が増えるほどrecipe_ingredientsテーブル全体を毎回スキャンすることになり、
  // レシピ一覧表示が遅くなる最大の原因になっていた（recipesテーブル自体は件数が少なくても、
  // 材料の合計行数はレシピ数×平均材料数で増えるため、こちらの影響の方が大きいケースが多い）。
  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id          String   @id @default(uuid())
  recipeId    String
  stepNumber  Int
  instruction String
  createdAt   DateTime @default(now())
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_steps")
}

model Label {
  id              String          @id @default(uuid())
  recipeId        String
  shopId          String?
  userId          String
  manufactureDate DateTime        @default(now()) @db.Date
  expiryDate      DateTime?       @db.Date
  printCount      Int             @default(1)
  fontSizePt      Decimal         @default(8) @db.Decimal(4, 1)
  deviceType      PrintDeviceType @default(LABEL_PRINTER)
  labelWidthMm    Decimal?        @db.Decimal(6, 1)
  labelHeightMm   Decimal?        @db.Decimal(6, 1)
  isPrecut        Boolean         @default(true)
  cutMarginMm     Decimal?        @db.Decimal(4, 1)
  a4Cols          Int?
  a4Rows          Int?
  marginTopMm     Decimal?        @db.Decimal(4, 1)
  marginBottomMm  Decimal?        @db.Decimal(4, 1)
  marginLeftMm    Decimal?        @db.Decimal(4, 1)
  marginRightMm   Decimal?        @db.Decimal(4, 1)
  startPosition   Int             @default(1)
  displaySettings Json?
  generatedHtml   String?
  // 2026-08 プロプラン新設: ロット番号トレーサビリティ（Pro限定）。この印刷（製造バッチ）で
  // 使用した原材料のロット番号を任意で記録する。在庫の数量管理（残数・期限切れアラート等）は
  // 別アプリ（ユーザーが別途開発中の在庫管理アプリ）の役割とし、ここでは「どのバッチにどの
  // ロットを使ったか」の記録・検索（回収時のトレース）に機能を絞る。
  // lotInfo: [{ ingredientName, lotNumber }, ...] 形式のスナップショット（食材マスタの改廃に
  // 影響されないよう、入力時点の名称をそのまま保持する）。
  lotInfo         Json?
  // lotInfoの内容を小文字化・連結した検索用テキスト（部分一致検索を単純なcontainsで行うため）。
  lotSearchText   String?
  createdAt       DateTime        @default(now())
  recipe          Recipe          @relation(fields: [recipeId], references: [id])
  shop            Shop?           @relation(fields: [shopId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("labels")
}

model AllergenMaster {
  id           String           @id @default(uuid())
  name         String           @unique @db.VarChar(50)
  category     AllergenCategory
  keywords     String[]
  displayOrder Int              @default(0)
  isActive     Boolean          @default(true)

  @@map("allergen_master")
}

model Subscription {
  id                   String    @id @default(uuid())
  userId               String
  stripeSubscriptionId String?   @unique @db.VarChar(100)
  stripePriceId        String?   @db.VarChar(100)
  plan                 UserPlan
  status               String?   @db.VarChar(50)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String   @db.VarChar(100)
  targetType String?  @db.VarChar(50)
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id])

  @@map("admin_logs")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model label_print_logs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String
  recipeId   String?
  printCount Int      @default(1)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  users      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt], map: "idx_label_print_logs_user_date")
}

enum UserPlan {
  free
  premium
  pro
  admin
}

enum ShelfLifeType {
  BEST_BEFORE
  USE_BY
}

enum StorageType {
  ROOM_TEMP
  FRIDGE
  FROZEN
  OTHER
}

enum PrintDeviceType {
  LABEL_PRINTER
  A4_PRINTER
  OTHER
}

enum AllergenCategory {
  REQUIRED_8
  OPTIONAL_20
}
