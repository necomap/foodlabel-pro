generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  emailVerified        Boolean            @default(false)
  emailVerifyToken     String?
  passwordHash         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  companyName          String             @db.VarChar(200)
  representative       String?            @db.VarChar(100)
  postalCode           String?            @db.VarChar(8)
  address              String?
  phone                String?            @db.VarChar(20)
  plan                 UserPlan           @default(free)
  stripeCustomerId     String?            @db.VarChar(100)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  emailVerifyExpires   DateTime?
  loginFailCount       Int                @default(0)
  loginLockedUntil     DateTime?
  adminLogs            AdminLog[]
  ingredients          Ingredient[]
  label_print_logs     label_print_logs[]
  labels               Label[]
  recipes              Recipe[]
  shops                Shop[]
  subscriptions        Subscription[]

  @@map("users")
}

model Shop {
  id                 String   @id @default(uuid())
  userId             String
  shopName           String   @db.VarChar(200)
  companyName        String?  @db.VarChar(200)
  representative     String?  @db.VarChar(100)
  postalCode         String?  @db.VarChar(8)
  address            String?
  phone              String?  @db.VarChar(20)
  email              String?  @db.VarChar(255)
  showPhone          Boolean  @default(true)
  showRepresentative Boolean  @default(false)
  showEmail          Boolean  @default(false)
  isDefault          Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  qrUrl              String?
  logoUrl            String?
  logoHeightMm       Int      @default(8)
  qrSizeMm           Int      @default(6)
  labels             Label[]
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shops")
}

model Category {
  id        String   @id @default(uuid())
  userId    String?
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  recipes   Recipe[]

  @@map("categories")
}

model NutritionData {
  id             Int          @id
  foodGroup      String?      @db.VarChar(10)
  foodName       String
  indexName      String?      @db.VarChar(200)
  wasteRatio     Decimal?     @db.Decimal(5, 2)
  energyKcal     Decimal?     @db.Decimal(8, 1)
  energyKj       Decimal?     @db.Decimal(8, 1)
  water          Decimal?     @db.Decimal(6, 2)
  protein        Decimal?     @db.Decimal(6, 2)
  fat            Decimal?     @db.Decimal(6, 2)
  cholesterol    Decimal?     @db.Decimal(6, 2)
  carbohydrate   Decimal?     @db.Decimal(6, 2)
  dietaryFiber   Decimal?     @db.Decimal(6, 2)
  sugar          Decimal?     @db.Decimal(6, 2)
  ash            Decimal?     @db.Decimal(6, 2)
  sodium         Decimal?     @db.Decimal(8, 2)
  saltEquivalent Decimal?     @db.Decimal(6, 2)
  potassium      Decimal?     @db.Decimal(8, 2)
  calcium        Decimal?     @db.Decimal(8, 2)
  magnesium      Decimal?     @db.Decimal(8, 2)
  alcohol        Decimal?     @db.Decimal(6, 2)
  notes          String?
  dataVersion    String       @default("2020") @db.VarChar(20)
  createdAt      DateTime     @default(now())
  ingredients    Ingredient[]

  @@map("nutrition_data")
}

model IngredientCategory {
  id          String       @id @default(uuid())
  userId      String
  name        String       @db.VarChar(100)
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  ingredients Ingredient[]

  @@map("ingredient_categories")
}

model Ingredient {
  id                   String              @id @default(uuid())
  userId               String?
  ingredientCategoryId String?
  name                 String              @db.VarChar(200)
  nameKana             String?             @db.VarChar(200)
  nameSearch           String?
  nutritionId          Int?
  nutritionVariant     String?             @db.VarChar(100)
  purchaseUnitG        Int?
  purchasePrice        Decimal?            @db.Decimal(10, 2)
  unitPrice            Decimal?            @db.Decimal(10, 4)
  storage              StorageType         @default(ROOM_TEMP)
  supplier             String?             @db.VarChar(100)
  productCode          String?             @db.VarChar(100)
  allergens            String[]
  isPublic             Boolean             @default(false)
  isApproved           Boolean             @default(false)
  energyKcalManual     Decimal?            @db.Decimal(8, 1)
  proteinManual        Decimal?            @db.Decimal(6, 2)
  fatManual            Decimal?            @db.Decimal(6, 2)
  carbohydrateManual   Decimal?            @db.Decimal(6, 2)
  sodiumManual         Decimal?            @db.Decimal(8, 2)
  saltEquivalentManual Decimal?            @db.Decimal(6, 2)
  dietaryFiberManual   Decimal?            @db.Decimal(6, 2)
  sugarManual          Decimal?            @db.Decimal(6, 2)
  cholesterolManual    Decimal?            @db.Decimal(6, 2)
  genericName          String?             @db.VarChar(200)
  genericNameConfirmed Boolean             @default(false)
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  ingredientCategory   IngredientCategory? @relation(fields: [ingredientCategoryId], references: [id])
  nutritionData        NutritionData?      @relation(fields: [nutritionId], references: [id])
  user                 User?               @relation(fields: [userId], references: [id])
  recipeIngredients    RecipeIngredient[]

  @@map("ingredients")
}

model Recipe {
  id               String             @id @default(uuid())
  userId           String
  categoryId       String?
  name             String             @db.VarChar(200)
  nameKana         String?            @db.VarChar(200)
  variationName    String?            @db.VarChar(100)
  unitCount        Int                @default(1)
  wasteRatio       Decimal            @default(0) @db.Decimal(5, 2)
  moldType         String?            @db.VarChar(50)
  wasteAmountG     Decimal?           @db.Decimal(10, 2)
  salePrice        Decimal?           @db.Decimal(10, 2)
  shelfLifeDays    Int?
  shelfLifeType    ShelfLifeType      @default(BEST_BEFORE)
  contentAmount    String?            @db.VarChar(50)
  storageMethod    String?            @default("直射日光・高温多湿を避けて保存してください。")
  barcode          String?
  notes            String?
  printComment     String?
  qualityControl   String?            @db.VarChar(100)
  bakingConditions Json?
  totalCost        Decimal?           @db.Decimal(10, 2)
  unitCost         Decimal?           @db.Decimal(10, 2)
  costRate         Decimal?           @db.Decimal(5, 4)
  totalWeightG     Decimal?           @db.Decimal(10, 2)
  energyKcal       Decimal?           @db.Decimal(8, 1)
  protein          Decimal?           @db.Decimal(6, 2)
  fat              Decimal?           @db.Decimal(6, 2)
  carbohydrate     Decimal?           @db.Decimal(6, 2)
  sodium           Decimal?           @db.Decimal(8, 2)
  saltEquivalent   Decimal?           @db.Decimal(6, 2)
  dietaryFiber     Decimal?           @db.Decimal(6, 2)
  sugar            Decimal?           @db.Decimal(6, 2)
  cholesterol      Decimal?           @db.Decimal(6, 2)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  labels           Label[]
  ingredients      RecipeIngredient[]
  steps            RecipeStep[]
  category         Category?          @relation(fields: [categoryId], references: [id])
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recipes")
}

model RecipeIngredient {
  id                     String      @id @default(uuid())
  recipeId               String
  ingredientId           String?
  ingredientNameOverride String?     @db.VarChar(200)
  amount                 Decimal     @db.Decimal(10, 3)
  unit                   String      @default("g") @db.VarChar(10)
  displayOrder           Int         @default(0)
  sortByWeight           Boolean     @default(true)
  originCountry          String?     @db.VarChar(100)
  isPrimaryIngredient    Boolean     @default(false)
  costPrice              Decimal?    @db.Decimal(10, 4)
  costTotal              Decimal?    @db.Decimal(10, 2)
  allergenOverride       String[]
  energyKcal             Decimal?    @db.Decimal(8, 1)
  protein                Decimal?    @db.Decimal(6, 2)
  fat                    Decimal?    @db.Decimal(6, 2)
  carbohydrate           Decimal?    @db.Decimal(6, 2)
  sodium                 Decimal?    @db.Decimal(8, 2)
  saltEquivalent         Decimal?    @db.Decimal(6, 2)
  dietaryFiber           Decimal?    @db.Decimal(6, 2)
  sugar                  Decimal?    @db.Decimal(6, 2)
  cholesterol            Decimal?    @db.Decimal(6, 2)
  nutritionUnconfirmed   Boolean     @default(false)
  createdAt              DateTime    @default(now())
  isAdditive             Boolean     @default(false)
  additiveReason         String?
  ingredient             Ingredient? @relation(fields: [ingredientId], references: [id])
  recipe                 Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_ingredients")
}

model RecipeStep {
  id          String   @id @default(uuid())
  recipeId    String
  stepNumber  Int
  instruction String
  createdAt   DateTime @default(now())
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_steps")
}

model Label {
  id              String          @id @default(uuid())
  recipeId        String
  shopId          String?
  userId          String
  manufactureDate DateTime        @default(now()) @db.Date
  expiryDate      DateTime?       @db.Date
  printCount      Int             @default(1)
  fontSizePt      Decimal         @default(8) @db.Decimal(4, 1)
  deviceType      PrintDeviceType @default(LABEL_PRINTER)
  labelWidthMm    Decimal?        @db.Decimal(6, 1)
  labelHeightMm   Decimal?        @db.Decimal(6, 1)
  isPrecut        Boolean         @default(true)
  cutMarginMm     Decimal?        @db.Decimal(4, 1)
  a4Cols          Int?
  a4Rows          Int?
  marginTopMm     Decimal?        @db.Decimal(4, 1)
  marginBottomMm  Decimal?        @db.Decimal(4, 1)
  marginLeftMm    Decimal?        @db.Decimal(4, 1)
  marginRightMm   Decimal?        @db.Decimal(4, 1)
  startPosition   Int             @default(1)
  displaySettings Json?
  generatedHtml   String?
  createdAt       DateTime        @default(now())
  recipe          Recipe          @relation(fields: [recipeId], references: [id])
  shop            Shop?           @relation(fields: [shopId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@map("labels")
}

model AllergenMaster {
  id           String           @id @default(uuid())
  name         String           @unique @db.VarChar(50)
  category     AllergenCategory
  keywords     String[]
  displayOrder Int              @default(0)
  isActive     Boolean          @default(true)

  @@map("allergen_master")
}

model Subscription {
  id                   String    @id @default(uuid())
  userId               String
  stripeSubscriptionId String?   @unique @db.VarChar(100)
  stripePriceId        String?   @db.VarChar(100)
  plan                 UserPlan
  status               String?   @db.VarChar(50)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String   @db.VarChar(100)
  targetType String?  @db.VarChar(50)
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id])

  @@map("admin_logs")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model label_print_logs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String
  recipeId   String?
  printCount Int      @default(1)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  users      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt], map: "idx_label_print_logs_user_date")
}

enum UserPlan {
  free
  premium
  admin
}

enum ShelfLifeType {
  BEST_BEFORE
  USE_BY
}

enum StorageType {
  ROOM_TEMP
  FRIDGE
  FROZEN
  OTHER
}

enum PrintDeviceType {
  LABEL_PRINTER
  A4_PRINTER
  OTHER
}

enum AllergenCategory {
  REQUIRED_8
  OPTIONAL_20
}
