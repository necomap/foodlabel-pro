{
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/onboarding",
      "schedule": "0 1 * * *"
    }
  ],
  "functions": {
    "app/api/import-export/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/backup/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/onboarding/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/nutrition-import/route.ts": {
      "maxDuration": 300
    }
  }
}
